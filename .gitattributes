* text=auto

# Scripts de Gradle: deben conservar LF para funcionar en Unix.
gradlew text eol=lf
*.sh text eol=lf

# Windows
*.bat text eol=crlf

# Código y recursos
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.properties text eol=lf

# Binarios
*.jar binary
*.png binary
*.apk binary
*.aab binary
